{
  "manifest_version": 3,
  "name": "AI Comment Generator",
  "version": "1.0.0",
  "description": "Generate AI-powered comments for LinkedIn, Facebook & Instagram",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.facebook.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "AI Comment Generator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
